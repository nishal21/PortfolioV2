# Copy to /opt/portfolio-v2/.env.production on the VPS
NODE_ENV=production
PORT=3002
NEXT_PUBLIC_SITE_URL=https://nishal.dev

# Optional — Bing Webmaster verification (meta msvalidate.01)
# BING_SITE_VERIFICATION=your-bing-verification-code

# Optional — Pinterest domain claim (meta p:domain_verify)
# PINTEREST_DOMAIN_VERIFY=your-pinterest-verification-code

# Optional — IndexNow POST /api/indexnow (only if you use the API route)
# INDEXNOW_SECRET=generate-a-long-random-string

# Brevo contact form (required for /api/contact in production)
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=hi@nishal.dev
# BREVO_SENDER_NAME=Nishal
# BREVO_TO_EMAIL=nishalamv@gmail.com
