# Public site URL (production)
NEXT_PUBLIC_SITE_URL=https://nishal.dev

# Hero background video (default: Cloudinary). Use /hero.mp4 to self-host.
# NEXT_PUBLIC_HERO_VIDEO_URL=https://res.cloudinary.com/dtzzqvvzi/video/upload/v1781247946/hero.mp4
# NEXT_PUBLIC_HERO_VIDEO_POSTER=https://res.cloudinary.com/dtzzqvvzi/video/upload/so_0,q_auto,f_jpg,w_1280/v1781247946/hero.jpg

# IndexNow key — must match public/{key}.txt (default committed in repo)
INDEXNOW_KEY=f8c2a41e9b3d7046e1a5c890d7f6b2e4

# Optional: Bing Webmaster verification (meta msvalidate.01)
# BING_SITE_VERIFICATION=

# Optional: Pinterest domain claim (meta p:domain_verify) — Settings → Claimed accounts
# PINTEREST_DOMAIN_VERIFY=

# Optional: protect POST /api/indexnow (use: Authorization: Bearer <secret>)
INDEXNOW_SECRET=
